<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>Spacewing</string>
    <key>CFBundleIdentifier</key><string>dev.spacewing.Spacewing</string>
    <key>CFBundleName</key><string>Spacewing</string>
    <key>CFBundleDisplayName</key><string>Spacewing</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>@PROJECT_VERSION@</string>
    <key>CFBundleVersion</key><string>@PROJECT_VERSION@</string>
    <key>LSUIElement</key><true/>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSScreenCaptureUsageDescription</key>
    <string>Show live previews of windows while you choose a window to switch to.</string>
</dict></plist>
